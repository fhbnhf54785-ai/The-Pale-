const $ = id => document.getElementById(id);
let current = null;

function renderScene(id){
  const sc = GAME[id];
  if(!sc) return;
  current = id;

  if(sc.act) sc.act(state);
  state.soul = Math.max(0, Math.min(100, state.soul));

  document.body.className = sc.bg || 'dream';

  $('soul-fill').style.width = state.soul + '%';
  $('soul-fill').style.background =
    state.soul > 60 ? '#7c7898' :
    state.soul > 30 ? '#9a8a7a' : '#a07070';
  const dots = $('mem-dots');
  dots.innerHTML = '';
  for(let i=0;i<Math.min(state.memory,8);i++){
    const d = document.createElement('span');
    d.className = 'mem-dot';
    dots.appendChild(d);
  }

  const ta = $('text-area');
  ta.innerHTML = '';
  sc.text.split('\n\n').forEach((para, i)=>{
    const p = document.createElement('p');
    p.textContent = para;
    p.style.animationDelay = (i*0.12)+'s';
    ta.appendChild(p);
  });
  ta.scrollTop = 0;

  const ch = $('choices');
  ch.innerHTML = '';

  if(sc.ending){
    const p = document.createElement('p');
    p.textContent = '—— ' + sc.ending + ' ——';
    p.style.textAlign = 'center';
    p.style.color = '#6a6580';
    p.style.marginTop = '20px';
    p.style.animationDelay = '.6s';
    ta.appendChild(p);

    const btn = document.createElement('button');
    btn.className = 'choice';
    btn.textContent = '回到标题';
    btn.onclick = restart;
    ch.appendChild(btn);
    return;
  }

  if(sc.choices){
    sc.choices.forEach(c=>{
      const btn = document.createElement('button');
      btn.className = 'choice';
      btn.textContent = c.label;
      btn.onclick = ()=> renderScene(c.next);
      ch.appendChild(btn);
    });
  } else if(sc.next){
    const btn = document.createElement('button');
    btn.className = 'choice';
    btn.textContent = '继续';
    btn.onclick = ()=> renderScene(sc.next);
    ch.appendChild(btn);
  }
}

function restart(){
  state = { soul:100, memory:0 };
  $('game').classList.remove('active');
  $('title').classList.remove('hidden');
  $('text-area').innerHTML = '';
  $('choices').innerHTML = '';
  document.body.className = 'dream';
}

$('start-btn').addEventListener('click', ()=>{
  $('title').classList.add('hidden');
  setTimeout(()=>{
    $('game').classList.add('active');
    renderScene('start');
  }, 400);
});
</script>
